// Cloudflare Worker that serves the built site (Workers Builds runs `npm run build`, then `npx wrangler deploy`).
{
  "name": "revue-juristes-sciences-po",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
