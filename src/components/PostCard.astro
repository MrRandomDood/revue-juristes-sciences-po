---
import type { CollectionEntry } from 'astro:content';
import { url, formatDate, t, type Lang } from '../lib/i18n';

interface Props { post: CollectionEntry<'posts'>; lang: Lang }
const { post, lang } = Astro.props;
const { title, author, date, cover, description } = post.data;
// Wix descriptions were often empty; fall back to the start of the article.
const excerpt = description || (post.body ?? '')
  .replace(/[\\*_#>`]/g, '')
  .replace(/\[\[\d+\]\]\([^)]*\)|\[\d+\]/g, '') // footnote markers, linked or plain
  .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 280);
---
<a class="card" href={url(lang, `post/${post.id}`)} data-lang={post.data.lang}>
  <div class="card-media">
    {cover ? <img src={cover} alt="" loading="lazy" /> : <span class="card-placeholder" aria-hidden="true">RJSP</span>}
  </div>
  <div class="card-body">
    <h3>{title}</h3>
    <p>{excerpt}</p>
    <div class="meta">
      {author && <span>{author}</span>}
      <span>{formatDate(date, lang)}</span>
      {post.data.lang !== lang && <span class="badge">{t[lang].langLabel[post.data.lang]}</span>}
    </div>
  </div>
</a>
